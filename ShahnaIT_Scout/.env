# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=production
SECRET_KEY=your-super-secret-key-change-this-in-production-123456789

# Database Configuration
DATABASE_URL=sqlite:///recruitment.db
# For production MySQL (uncomment when ready):
# DATABASE_URL=mysql+pymysql://root:rootpass@db:3306/recruitment_db

# Gemini AI (FREE - Get from Google AI Studio)
# Get your API key here: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# Email Configuration (Gmail)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@shahnaiT.com

# LinkedIn API (Optional - for profile enrichment)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://yourapp.com/auth/linkedin/callback

# Naukri API (Paid Enterprise - Optional)
NAUKRI_API_KEY=
NAUKRI_API_SECRET=

# Google Calendar (Optional)
GOOGLE_CALENDAR_CREDENTIALS={}

# Twilio SMS (Optional - for TextToHire feature)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Agora Video (Optional - for AI Interviewer)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Cloud Storage (Google Drive - Optional)
GOOGLE_DRIVE_CREDENTIALS={}
GOOGLE_DRIVE_FOLDER_ID=

# GitHub OAuth (Optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Webhook Secret (For integrations)
WEBHOOK_SECRET=your-webhook-secret-here

# Redis URL (For background tasks)
REDIS_URL=redis://localhost:6379
